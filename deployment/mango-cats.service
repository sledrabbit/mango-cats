[Unit]
Description=Mango Cats feeding counter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mango-cats
Group=mango-cats
Environment=DB_PATH=/var/lib/mango-cats/cats.db
ExecStart=/usr/local/bin/mango-cats
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mango-cats
PrivateTmp=true

[Install]
WantedBy=multi-user.target
